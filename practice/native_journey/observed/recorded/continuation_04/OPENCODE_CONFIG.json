{
  "$schema": "https://opencode.ai/config.json",
  "model": "esa-local/esa-qwen3-4b",
  "small_model": "esa-local/esa-qwen3-4b",
  "enabled_providers": [
    "esa-local"
  ],
  "autoupdate": false,
  "share": "disabled",
  "compaction": {
    "auto": false
  },
  "provider": {
    "esa-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "ESA local llama.cpp",
      "options": {
        "baseURL": "http://127.0.0.1:18080/v1",
        "timeout": 600000,
        "headerTimeout": 600000
      },
      "models": {
        "esa-qwen3-4b": {
          "name": "Qwen3-4B Q4_K_M local",
          "tool_call": true,
          "limit": {
            "context": 16384,
            "output": 2048
          },
          "temperature": true
        }
      }
    }
  },
  "default_agent": "esa-csv",
  "agent": {
    "esa-csv": {
      "description": "Small specification-first CSV implementation",
      "mode": "primary",
      "model": "esa-local/esa-qwen3-4b",
      "temperature": 0.2,
      "steps": 6,
      "prompt": "Make only the requested tiny cleanup with actual file tools. Run the exact check after the edit. Report only the edit and result that really occurred, in three short sentences, and stop."
    }
  },
  "permission": {
    "*": "deny",
    "read": {
      "*": "deny",
      "workspace/scratch/72d789d25fef/runtime_d9/native_csv_01/spec.md": "allow",
      "workspace/scratch/72d789d25fef/runtime_d9/native_csv_01/plan.md": "allow",
      "workspace/scratch/72d789d25fef/runtime_d9/native_csv_01/api.py": "allow",
      "workspace/scratch/72d789d25fef/runtime_d9/native_csv_01/presenter.py": "allow"
    },
    "edit": {
      "*": "deny",
      "workspace/scratch/72d789d25fef/runtime_d9/native_csv_01/api.py": "allow"
    },
    "external_directory": "deny",
    "glob": "deny",
    "grep": "deny",
    "task": "deny",
    "skill": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "bash": {
      "*": "deny",
      "python3 -B /workspace/scratch/72d789d25fef/revision_20261022_d9/Engineering_Software_with_Agentic_AI_20261022_d9/companion/practice/csv_export/checks/check.py --candidate /workspace/scratch/72d789d25fef/runtime_d9/native_csv_01": "allow"
    }
  },
  "mcp": {}
}
