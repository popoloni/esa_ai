{
  "id": "mission_G2",
  "schema_version": 1,
  "evidence_profile": "persistent_effect",
  "expect": {
    "outcome": "Complete admission and replay while preserving stored G1 work.",
    "authority": {
      "owner": "Workshop coordinator",
      "source": "companion/contracts/G2.md; companion/contracts/G2_OD_02.md",
      "version": "RES-001/v1 + G2-OD-01 + G2-OD-02",
      "status": "TEACHING_CONTRACT"
    },
    "acceptance": [
      "Identity, conflicts and migration preserve public fields/history for the three explicitly authorized G1 signatures; unknown mappings are refused."
    ]
  },
  "delegate": {
    "editable_paths": [
      "booking.py",
      "DOSSIER.md"
    ],
    "protected_paths": [
      "docs/",
      "tests/",
      "READER_ENTRY.json",
      "prior/",
      "legacy_g1.py",
      "legacy_g1_json.py",
      "legacy_g1_recorded.py"
    ],
    "budget": {
      "max_attempts": 3,
      "implementation_minutes": 40,
      "check_timeout_seconds": 30,
      "max_external_calls": 0
    },
    "stop_conditions": [
      "Ambiguous legacy identity, unknown schema or new recurring-series rule.",
      "Protected inputs change or the declared attempt/time budget is spent."
    ]
  },
  "observe": {
    "checks": [
      {
        "id": "g2.check",
        "stage": "contract",
        "method": "command",
        "argv": [
          "python3",
          "companion/start.py",
          "check",
          "G2",
          "--candidate",
          "work/g2",
          "--output",
          "work/evidence/g2-first.json"
        ],
        "expected": "Selected public checks pass on unchanged inputs."
      },
      {
        "id": "g2.continue",
        "stage": "integration",
        "method": "command",
        "argv": [
          "python3",
          "companion/start.py",
          "continue",
          "G2",
          "--candidate",
          "work/g2",
          "--output",
          "work/evidence/g2-handoff.json"
        ],
        "expected": "Current candidate completes its scoped continuation; inspect retained observations."
      }
    ],
    "receipt_fields": [
      "candidate_sha256_before",
      "groups",
      "inputs_unchanged",
      "verification_progress",
      "human_acceptance"
    ]
  },
  "decide": {
    "owner": "Learner reviewer; Workshop coordinator for a changed rule.",
    "object": "G2 candidate, identified bytes and its scoped handoff.",
    "allowed_decisions": [
      "ACCEPT",
      "REJECT",
      "ASK"
    ]
  }
}
