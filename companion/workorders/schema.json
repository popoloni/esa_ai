{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:esa:edod:work-order:1",
  "title": "ESA EDOD work order version1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schema_version",
    "evidence_profile",
    "expect",
    "delegate",
    "observe",
    "decide"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "evidence_profile": {
      "type": "string",
      "enum": [
        "bounded_repair",
        "new_capability",
        "persistent_effect",
        "investigation"
      ]
    },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "authority",
        "acceptance"
      ],
      "properties": {
        "outcome": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "owner",
            "source",
            "version",
            "status"
          ],
          "properties": {
            "owner": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "type": "string",
              "enum": [
                "TEACHING_CONTRACT",
                "APPROVED_SCOPE",
                "AWAITING_OWNER"
              ]
            }
          }
        },
        "acceptance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "delegate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "editable_paths",
        "protected_paths",
        "budget",
        "stop_conditions"
      ],
      "properties": {
        "editable_paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "protected_paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_attempts",
            "implementation_minutes",
            "check_timeout_seconds",
            "max_external_calls"
          ],
          "properties": {
            "max_attempts": {
              "type": "integer",
              "minimum": 1
            },
            "implementation_minutes": {
              "type": "integer",
              "minimum": 1
            },
            "check_timeout_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60
            },
            "max_external_calls": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "stop_conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "observe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checks",
        "receipt_fields"
      ],
      "properties": {
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "stage",
              "method",
              "argv",
              "expected"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "stage": {
                "type": "string",
                "enum": [
                  "startup",
                  "integrity",
                  "contract",
                  "integration",
                  "artifact",
                  "authorization"
                ]
              },
              "method": {
                "type": "string",
                "enum": [
                  "command",
                  "review"
                ]
              },
              "argv": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "expected": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "receipt_fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "decide": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "object",
        "allowed_decisions"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "object": {
          "type": "string",
          "minLength": 1
        },
        "allowed_decisions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "ACCEPT",
              "REJECT",
              "ASK"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  }
}
